<Window x:Class="OfflineMaps.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Offline Maps" Width="1280" Height="800" MinWidth="960" MinHeight="640"
        Background="#E8EEF5">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#D7E0EA" BorderThickness="0,0,1,0">
      <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="OFFLINE MAPS" FontSize="20" FontWeight="Bold" Foreground="#12304A"/>
          <TextBlock Text="Maps, search, and navigation without a connection" TextWrapping="Wrap" Foreground="#60758A" Margin="0,4,0,22"/>
          <TextBlock Text="SEARCH" FontSize="11" FontWeight="Bold" Foreground="#60758A"/>
          <TextBox x:Name="SearchBox" Height="38" Margin="0,6,0,20" Padding="10" TextChanged="SearchBox_OnTextChanged"/>
          <ListBox x:Name="SearchResults" Height="150" Margin="0,0,0,16" BorderBrush="#D7E0EA" DisplayMemberPath="Name"/>
          <TextBlock Text="VOICE GUIDANCE" FontSize="11" FontWeight="Bold" Foreground="#60758A"/>
          <ComboBox x:Name="VoiceModeBox" Height="34" Margin="0,6,0,8" SelectedIndex="0">
            <ComboBoxItem Content="Natural Windows voice"/>
            <ComboBoxItem Content="My recorded voice"/>
          </ComboBox>
          <Button Content="Record / manage voice prompts" Height="34" Click="RecordVoice_OnClick" Margin="0,0,0,20"/>
          <TextBlock Text="DOWNLOADED REGIONS" FontSize="11" FontWeight="Bold" Foreground="#60758A"/>
          <ListBox x:Name="RegionsList" Margin="0,8,0,0" BorderThickness="0" Background="Transparent">
            <ListBoxItem Content="No regions downloaded yet" Foreground="#60758A"/>
          </ListBox>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="Download region" Height="40" Click="DownloadRegion_OnClick"/>
          <TextBlock Text="Offline-first: network access is never required for map use." TextWrapping="Wrap" Foreground="#60758A" FontSize="11" Margin="0,12,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Border Margin="16" CornerRadius="10" Background="#DCE6EF" BorderBrush="#B8C9D8" BorderThickness="1">
        <Grid x:Name="MapHost">
          <Canvas x:Name="MapCanvas" Background="#DCE6EF"/>
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F8FAFC" Padding="22" CornerRadius="8" Opacity="0.94">
            <StackPanel>
              <TextBlock Text="Offline map ready" FontSize="22" FontWeight="SemiBold" Foreground="#12304A" HorizontalAlignment="Center"/>
              <TextBlock x:Name="MapStatus" Text="Place an MBTiles package in the Maps folder to render it." Foreground="#60758A" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
            <Button Content="＋" Width="38" Height="38" Click="ZoomIn_OnClick"/>
            <Button Content="－" Width="38" Height="38" Margin="6,0,0,0" Click="ZoomOut_OnClick"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="34" Background="#F8FAFC" Padding="14" CornerRadius="8">
        <StackPanel><TextBlock Text="READY TO NAVIGATE" FontWeight="Bold" Foreground="#12304A"/><TextBlock Text="Select a destination to calculate an offline route." Foreground="#60758A"/></StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
